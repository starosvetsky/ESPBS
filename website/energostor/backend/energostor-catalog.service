[Unit]
Description=Energostor public catalog read-only API
After=network.target
[Service]
Type=simple
User=espbs
Group=espbs
WorkingDirectory=/opt/energostor-catalog
ExecStart=/usr/bin/python3 server.py --db /var/lib/energostor-catalog/catalog.sqlite3 --host 127.0.0.1 --port 8766
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/lib/espbs /var/lib/energostor-catalog
MemoryMax=512M
[Install]
WantedBy=multi-user.target
