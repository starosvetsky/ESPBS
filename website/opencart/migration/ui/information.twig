{{ header }}<section id="information-information" class="container ui-page">
{% include 'catalog/view/template/ui/crumbs.twig' %}
<header class="ui-info-heading"><p class="ui-eyebrow">{% if 'ed-article' in description %}Журнал Энергостора{% elseif 'legal-copy' in description %}Правовая информация{% else %}Энергостор{% endif %}</p><h1>{{ heading_title|e }}</h1></header>
{% if ui_page_path == '/contacts' %}<div class="ui-contact-cards"><div><span>Позвоните</span><a href="tel:+78122009340">8 (812) 200-93-40</a><button type="button" data-modal-open="callback">Заказать обратный звонок ↗</button></div><div><span>Напишите</span><a href="mailto:info@energostor.ru">info@energostor.ru</a><p>Запросы, спецификации и вопросы по поставке</p></div><div><span>Наш офис</span><p>Санкт-Петербург, ул. Ивана Черных,<br>д. 29, литера А, пом. 21-Н, офис 317</p><a class="ui-text-link" href="requisites">Реквизиты компании ↗</a></div></div>{% endif %}
<div class="ui-info-layout"><article id="content" class="ui-richtext ui-information-content">{{ description }}</article><aside class="ui-info-aside"><nav data-page-toc aria-label="На этой странице" hidden><p>На этой странице</p><div></div></nav>{% if 'legal-copy' not in description and 'ed-article' not in description %}<div class="ui-info-help"><p>Обсудим ваш проект</p><span>Поможем уточнить состав оборудования и варианты поставки.</span><button type="button" class="btn btn--primary" data-modal-open="spec">Отправить запрос ↗</button><a href="tel:+78122009340">8 (812) 200-93-40</a></div>{% endif %}</aside></div>
</section>{{ footer }}
{% endif %}
