{{ header }}<section class="container ui-page ui-product-page">
<nav class="ui-crumbs" aria-label="Хлебные крошки"><a href="./">Главная</a><span>/</span><a href="catalog">Каталог</a>{% if manufacturer %}<span>/</span><a href="{{ manufacturers|e('html_attr') }}">{{ manufacturer|e }}</a>{% endif %}<span>/</span><span aria-current="page">{{ model|default(heading_title)|e }}</span></nav>
<div class="ui-product-heading"><div>{% if manufacturer %}<a class="ui-eyebrow" href="{{ manufacturers|e('html_attr') }}">{{ manufacturer|e }}</a>{% endif %}<h1>{{ heading_title|e }}</h1></div><a class="ui-text-link" href="catalog">В каталог ↗</a></div>
<div class="ui-product-detail">
<div class="ui-product-visual{% if not release_media.images %} is-empty{% endif %}">{% if release_media.images %}<a href="{{ release_media.images[0]|e('html_attr') }}" target="_blank" rel="noopener noreferrer"><img src="{{ release_media.images[0]|e('html_attr') }}" alt="{{ heading_title|e('html_attr') }}" width="600" height="480" referrerpolicy="no-referrer"></a>{% if release_media.images|length > 1 %}<div class="ui-product-gallery">{% for image in release_media.images|slice(1) %}<a href="{{ image|e('html_attr') }}" target="_blank" rel="noopener noreferrer"><img src="{{ image|e('html_attr') }}" alt="{{ heading_title|e('html_attr') }} — изображение {{ loop.index + 1 }}" width="90" height="90" loading="lazy" referrerpolicy="no-referrer"></a>{% endfor %}</div>{% endif %}{% else %}<div class="ui-product-no-image"><svg viewBox="0 0 96 96" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"><path d="m18 28 30-17 30 17v40L48 85 18 68zM18 28l30 17 30-17M48 45v40M33 20l30 17"/></svg><span>Фотография пока не добавлена</span></div><div class="ui-product-overview"><h2>О позиции</h2>{% if description %}<p>{{ description|striptags|slice(0,420)|e }}{% if description|striptags|length > 420 %}…{% endif %}</p>{% else %}<p>Артикул {{ model|e }}{% if manufacturer %}, {{ manufacturer|e }}{% endif %}. Технические данные и комплектность уточним по вашему запросу.</p>{% endif %}</div>{% endif %}</div>
<div class="ui-product-summary"><p class="ui-eyebrow">Информация о позиции</p><dl class="ui-product-facts">{% if manufacturer %}<div><dt>Производитель</dt><dd><a href="{{ manufacturers|e('html_attr') }}">{{ manufacturer|e }}</a></dd></div>{% endif %}{% if model %}<div><dt>Артикул</dt><dd><span>{{ model|e }}</span><button type="button" class="ui-copy" data-copy="{{ model|e('html_attr') }}" aria-label="Скопировать артикул">Копировать</button></dd></div>{% endif %}</dl><div class="ui-product-request"><h2>Уточним наличие и сроки</h2><p>Проверим исполнение, комплектность и условия поставки под ваш запрос.</p><label class="ui-quantity">Количество <input id="quote-quantity" type="number" min="1" step="1" value="1" inputmode="numeric"></label><button type="button" class="btn btn--primary" data-modal-open="kp" data-product-request="{{ heading_title|e('html_attr') }}" data-product-model="{{ model|e('html_attr') }}">Запросить предложение ↗</button><a href="{{ quote_href|e('html_attr') }}" class="ui-text-link">Написать по этой позиции</a></div><p class="ui-product-note">Изображение и характеристики справочные. Перед заказом согласуем точный артикул и исполнение.</p></div>
</div>
<nav class="ui-product-tabs" aria-label="Содержание карточки">{% if description %}<a href="#product-description">Описание</a>{% endif %}{% if attribute_groups %}<a href="#product-attributes">Характеристики</a>{% endif %}{% if release_media.documents %}<a href="#product-documents">Документы</a>{% endif %}<a href="contacts">Связаться с нами ↗</a></nav>
<div class="ui-product-body">{% if description %}<section id="product-description" class="ui-richtext"><h2>Описание</h2>{{ description }}</section>{% endif %}{% if attribute_groups %}<section id="product-attributes"><h2>Характеристики</h2><dl class="ui-attributes">{% for group in attribute_groups %}{% for attribute in group.attribute %}<div><dt>{{ attribute.name|e }}</dt><dd>{{ attribute.text|e }}</dd></div>{% endfor %}{% endfor %}</dl></section>{% endif %}{% if release_media.documents %}<section id="product-documents"><h2>Документы</h2><div class="ui-documents">{% for document in release_media.documents %}<a href="{{ document|e('html_attr') }}" target="_blank" rel="noopener noreferrer nofollow"><span aria-hidden="true">↗</span><span>Документация к изделию {{ loop.index }}<small>Открыть на сайте источника</small></span></a>{% endfor %}</div></section>{% endif %}{% if not description and not attribute_groups and not release_media.documents %}<section class="ui-richtext"><h2>Уточним технические данные</h2><p>Для этой позиции пока нет подробной документации в каталоге. Укажите артикул в запросе — поможем уточнить характеристики и комплектность.</p></section>{% endif %}</div>
</section>{{ footer }}
