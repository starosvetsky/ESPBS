{{ header }}<section class="container ui-page">
<nav class="ui-crumbs" aria-label="Хлебные крошки"><a href="./">Главная</a><span>/</span><span>По брендам</span></nav><div class="ui-page-heading"><div><p class="ui-eyebrow">Производители в каталоге</p><h1>По брендам</h1><p class="ui-lead">Выберите производителя, чтобы посмотреть его оборудование и комплектующие.</p></div><a class="ui-text-link" href="catalog">Все разделы ↗</a></div>
<div class="ui-brand-search"><label class="ui-sr" for="brand-query">Найти бренд</label><input type="search" id="brand-query" data-brand-search placeholder="Введите название производителя" autocomplete="off"><p data-brand-status aria-live="polite"></p></div>
<nav class="ui-brand-alphabet" aria-label="По первой букве">{% for group in categories %}<a href="#brand-{{ loop.index }}">{{ group.name|e }}</a>{% endfor %}</nav>
<div data-brand-groups>{% for group in categories %}<section class="ui-brand-group" id="brand-{{ loop.index }}" data-brand-group><h2>{{ group.name|e }}</h2><div>{% for manufacturer in group.manufacturer %}<a data-brand-name="{{ manufacturer.name|e('html_attr') }}" href="{{ manufacturer.href|e('html_attr') }}">{{ manufacturer.name|e }}<span aria-hidden="true">↗</span></a>{% endfor %}</div></section>{% endfor %}</div><div class="ui-empty" data-brand-empty hidden><h2>Такой бренд не найден</h2><p>Проверьте написание или отправьте нам артикул нужного оборудования.</p><button type="button" class="btn btn--primary" data-modal-open="spec">Уточнить поставку</button></div>
</section>{{ footer }}
