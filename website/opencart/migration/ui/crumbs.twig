<nav class="ui-crumbs" aria-label="Хлебные крошки"><a href="./">Главная</a>{% if ui_listing_type|default('') in ['category','brand','search'] %}<span>/</span><a href="catalog">Каталог</a>{% endif %}{% for crumb in breadcrumbs|slice(1) %}<span aria-hidden="true">/</span>{% if loop.last %}<span aria-current="page">{{ crumb.text|striptags|replace({'Brands':'По брендам','Brand':'По брендам','Search':'Поиск'})|e }}</span>{% else %}<a href="{{ crumb.href|e('html_attr') }}">{{ crumb.text|striptags|replace({'Brands':'По брендам','Brand':'По брендам','Search':'Поиск'})|e }}</a>{% endif %}{% endfor %}</nav>
