{{ header }}{% import 'catalog/view/template/ui/macros.twig' as ui %}
<section class="container ui-page ui-catalog-page">
{% include 'catalog/view/template/ui/crumbs.twig' %}
<div class="ui-page-heading"><div><p class="ui-eyebrow">{% if ui_listing_type == 'brand' %}Производитель{% elseif ui_listing_type == 'search' %}Поиск по каталогу{% else %}Каталог оборудования{% endif %}</p><h1>{% if ui_listing_type == 'search' %}Результаты поиска{% else %}{{ heading_title|e }}{% endif %}</h1></div><a class="ui-text-link" href="brands">Все бренды ↗</a></div>
<div class="ui-catalog-layout">
{% include 'catalog/view/template/ui/sidebar.twig' %}
<div class="ui-listing-main">
{% if ui_listing_type == 'search' %}<form class="ui-page-search" action="index.php" role="search"><input type="hidden" name="route" value="product/search"><label class="ui-sr" for="catalog-query">Название или артикул</label><input id="catalog-query" type="search" name="search" value="{{ search|e('html_attr') }}" placeholder="Название, артикул или бренд" required><button class="btn btn--primary" type="submit">Найти</button><label class="ui-search-description"><input type="checkbox" name="description" value="1"{% if description %} checked{% endif %}> Искать также в описании</label></form>{% endif %}
{% if categories and ui_listing_type == 'category' %}<details class="ui-refine"><summary>Подразделы <span>{{ categories|length }} <span aria-hidden="true">⌄</span></span></summary><nav class="ui-subcategories" aria-label="Подразделы">{% for child in categories %}<a href="{{ child.href|e('html_attr') }}">{{ child.name|e }} <span aria-hidden="true">↗</span></a>{% endfor %}</nav></details>{% endif %}
<div class="ui-listing-toolbar"><p>{{ ui.positions(ui_product_total) }}{% if ui_listing_type == 'search' and search %} по запросу «{{ search|e }}»{% endif %}</p><div class="ui-listing-controls"><label><span class="ui-sr">Сортировка</span><select data-ui-navigate aria-label="Сортировка">{% for choice in sorts %}{% if 'price' not in choice.value and 'rating' not in choice.value %}<option value="{{ choice.href|e('html_attr') }}"{% if choice.value == '%s-%s'|format(sort,order) %} selected{% endif %}>{{ choice.text|e }}</option>{% endif %}{% endfor %}</select></label><div class="ui-view-switch" role="group" aria-label="Вид товаров"><button type="button" data-view="list" aria-label="Список товаров" aria-pressed="true">☰</button><button type="button" data-view="grid" aria-label="Плитка товаров" aria-pressed="false">▦</button></div></div></div>
{% if products %}<div class="ui-products" data-products data-layout="list">{% for product in products %}{{ product }}{% endfor %}</div><div class="ui-listing-pagination"><nav aria-label="Страницы товаров">{{ pagination }}</nav><span>{{ results|e }}</span><label class="ui-limit"><span>На странице</span><select data-ui-navigate aria-label="Товаров на странице">{% for choice in limits %}<option value="{{ choice.href|e('html_attr') }}"{% if choice.value == limit %} selected{% endif %}>{{ choice.text|e }}</option>{% endfor %}</select></label></div>
{% else %}<div class="ui-empty"><span class="ui-empty-icon" aria-hidden="true">⌕</span><h2>Ничего не нашлось</h2><p>Попробуйте другую часть артикула или название производителя. Если оборудование не найдено, отправьте нам спецификацию.</p><div><a class="btn btn--outline" href="catalog">Открыть каталог</a><button class="btn btn--primary" type="button" data-modal-open="spec">Отправить запрос</button></div></div>{% endif %}
</div></div></section>
{{ footer }}
